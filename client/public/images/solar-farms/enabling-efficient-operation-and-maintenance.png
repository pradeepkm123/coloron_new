        width: 100%;
        max-width: 100%;
        margin: 0;
        height: 50px;
        overflow: hidden;
        position: relative;
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .footer-navigation-block.active {
        border-bottom:1px solid #5d5d5d ;
