    .footer-body.global-footer .footer-body-content .footer-navigation-body .expand-icon .expand-remove {
        display: none;
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .footer-navigation-block.active .expand-icon .expand-add {
