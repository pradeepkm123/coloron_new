    .footer-body.global-footer .footer-body-content .footer-navigation-body .footer-navigation-block.no-title {
        display: none;
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .footer-navigation-block.no-menu .tilte .expand-icon {
