        margin-right: 40px;
    }
}
@media (max-width: 991px) {
    .footer-body.global-footer {
        padding-bottom: 20px;
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .footer-navigation-block {
        flex: 0 0 100%;
