    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .tilte .expand-icon {
        display: block;
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .tilte .expand-icon svg {
        width: 12px;
        height: 12px;
        color: rgba(255, 255, 255, 0.7);
    }
    .footer-body.global-footer .footer-body-content .footer-navigation-body .expand-icon .expand-add {
        display: block;
